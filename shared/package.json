{
  "name": "@smartgrade/shared",
  "version": "1.0.0",
  "private": true,
  "description": "SmartGrade 公共类型、常量、工具函数",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./enums/RoleCode": {
      "types": "./dist/enums/RoleCode.d.ts",
      "default": "./dist/enums/RoleCode.js"
    },
    "./enums/PermissionCode": {
      "types": "./dist/enums/PermissionCode.d.ts",
      "default": "./dist/enums/PermissionCode.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules dist"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.4"
  }
}
