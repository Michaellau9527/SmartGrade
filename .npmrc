; SmartGrade monorepo pnpm settings
; Disable hard-fail on un-reviewed dependency build scripts.
; NOTE: this does NOT run any install scripts — pnpm 10 still blocks them by
; default (only packages in pnpm.ignoredBuiltDependencies / pnpm-workspace.yaml
; are explicitly skipped, none are approved). It only downgrades the
; ERR_PNPM_IGNORED_BUILDS non-zero exit to a warning, matching pnpm 10 default.
strict-dep-builds=false
